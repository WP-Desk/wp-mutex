{
    "name": "wpdesk/wp-mutex",
    "description": "Mutex and persistent lease implementations for WordPress.",
    "keywords": [
        "lock",
        "mutex",
        "wordpress"
    ],
    "homepage": "https://github.com/WP-Desk/wp-mutex",
    "license": "MIT",
    "authors": [
        {
            "name": "WP Desk",
            "homepage": "https://wpdesk.net"
        },
        {
            "name": "Octolize",
            "homepage": "https://octolize.com"
        }
    ],
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "johnpbloch/wordpress-core": "^6.9",
        "johnpbloch/wordpress-core-installer": "^2",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^9.6",
        "wp-phpunit/wp-phpunit": "^6.9",
        "wpdesk/phpstan-rules": "^1",
        "wpdesk/wp-code-sniffer": "^1",
        "yoast/phpunit-polyfills": "^4"
    },
    "autoload": {
        "files": [
            "src/WPDesk/functions.php"
        ],
        "psr-4": {
            "WPDesk\\Mutex\\": "src/WPDesk/Mutex/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WPDesk\\Mutex\\Tests\\": "tests/"
        }
    },
    "extra": {
        "wordpress-install-dir": "vendor/wordpress"
    },
    "scripts": {
        "test": [
            "@test:unit",
            "@test:integration"
        ],
        "test:unit": "phpunit --configuration phpunit-unit.xml --colors=never",
        "test:integration": "phpunit --configuration phpunit-integration.xml --colors=never",
        "lint": "phpcs --warning-severity=0",
        "lint:fix": "phpcbf",
        "analyse": "phpstan analyse --memory-limit=1G --debug"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "johnpbloch/wordpress-core-installer": true,
            "phpstan/extension-installer": true
        },
        "sort-packages": true
    }
}
